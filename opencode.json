{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-3.8-flash",
  "providers": {
    "google": {
      "models": {
        "gemini-3.8-flash": {
          "limit": {
            "context": 1048576,
            "output": 8192
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "tools": {
        "bash": true,
        "read": true,
        "edit": true,
        "write": true,
        "glob": true,
        "grep": true,
        "list": true,
        "patch": false,
        "task": false,
        "todowrite": false,
        "webfetch": false,
        "websearch": false,
        "question": false,
        "lsp": false,
        "skill": false
      }
    }
  }
}
