{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-3.5-flash-lite",
  "providers": {
    "google": {
      "models": {
        "gemini-3.5-flash-lite": {
          "limit": {
            "context": 1048576,
            "output": 8192
          },
          "body": {
            "generationConfig": {
              "thinkingConfig": {
                "thinkingLevel": "MEDIUM"
              }
            }
          }
        },
        "gemini-3.1-flash-lite": {
          "limit": {
            "context": 1048576,
            "output": 8192
          },
          "body": {
            "generationConfig": {
              "thinkingConfig": {
                "thinkingLevel": "MEDIUM"
              }
            }
          }
        },
        "gemma-4-31b-it": {
          "limit": {
            "context": 262144,
            "output": 8192
          }
        },
        "gemma-4-26b-a4b-it": {
          "limit": {
            "context": 262144,
            "output": 8192
          }
        },
        "gemini-3.8-flash": {
          "limit": {
            "context": 1048576,
            "output": 8192
          },
          "body": {
            "generationConfig": {
              "thinkingConfig": {
                "thinkingLevel": "MEDIUM"
              }
            }
          }
        }
      },
      "env": [
        "GOOGLE_GENERATIVE_AI_API_KEY"
      ]
    },
    "openrouter": {
      "env": [
        "OPENROUTER_API_KEY"
      ],
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b:free": {
          "name": "NVIDIA Nemotron 3 Ultra (Free Fallback)",
          "limit": {
            "context": 1048576,
            "output": 8192
          }
        },
        "cohere/north-mini-code:free": {
          "name": "Cohere North Mini Code (Free Fallback)",
          "limit": {
            "context": 262144,
            "output": 8192
          }
        },
        "recursive/flint-v1.0:free": {
          "name": "Recursive Flint (Free)",
          "limit": {
            "context": 262144,
            "output": 8192
          }
        },
        "thinkingmachines/inkling-2-small:free": {
          "name": "Inkling 2 Small (Free; logged research endpoint)",
          "limit": {
            "context": 1048576,
            "output": 16384
          }
        },
        "baidu/ernie-5.5-flash-preview:free": {
          "name": "ERNIE 5.5 Flash Preview (Free)",
          "limit": {
            "context": 1024000,
            "output": 8192
          }
        },
        "nvidia/nemotron-3.5-lightning:free": {
          "name": "Nemotron 3.5 Lightning (Free; provider data use)",
          "limit": {
            "context": 262144,
            "output": 8192
          }
        },
        "nvidia/nemotron-3.5-super-vl:free": {
          "name": "Nemotron 3.5 Super VL (Free; provider data use)",
          "limit": {
            "context": 1048576,
            "output": 16384
          }
        }
      }
    },
    "cohere": {
      "env": [
        "COHERE_API_KEY"
      ],
      "models": {
        "north-mini-code": {
          "name": "North Mini Code (Cohere Trial)",
          "modelID": "north-mini-code-1.0",
          "limit": {
            "context": 262144,
            "output": 64000
          }
        },
        "command-a-plus": {
          "name": "Command A+ (Cohere Trial)",
          "modelID": "command-a-plus-05-2026",
          "limit": {
            "context": 128000,
            "output": 64000
          }
        },
        "command-a-reasoning": {
          "name": "Command A Reasoning (Cohere Trial)",
          "modelID": "command-a-reasoning-08-2025",
          "limit": {
            "context": 256000,
            "output": 32000
          }
        }
      }
    },
    "cloudflare-workers-ai": {
      "name": "Cloudflare Workers AI",
      "env": [
        "CLOUDFLARE_API_TOKEN"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.cloudflare.com/client/v4/accounts/{env:CLOUDFLARE_ACCOUNT_ID}/ai/v1"
      },
      "models": {
        "glm-4.7-flash": {
          "name": "GLM-4.7 Flash (Workers Free)",
          "modelID": "@cf/zai-org/glm-4.7-flash",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    }
  },
  "agents": {
    "build": {
      "description": "Primary Pocket Habitat implementation and repair agent. Builds integrated gameplay, fixes verified review/QA findings, and maintains project documentation.",
      "mode": "primary",
      "tools": {
        "bash": true,
        "read": true,
        "edit": true,
        "write": true,
        "glob": true,
        "grep": true,
        "list": true,
        "patch": false,
        "task": false,
        "todowrite": false,
        "webfetch": false,
        "websearch": false,
        "question": false,
        "lsp": false,
        "skill": false
      },
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  }
}
