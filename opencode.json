{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-3.5-flash-lite",
  "providers": {
    "google": {
      "models": {
        "gemini-3.5-flash-lite": {
          "limit": {
            "context": 1048576,
            "output": 8192
          },
          "body": {
            "generationConfig": {
              "thinkingConfig": {
                "thinkingLevel": "MEDIUM"
              }
            }
          }
        },
        "gemini-3.1-flash-lite": {
          "limit": {
            "context": 1048576,
            "output": 8192
          },
          "body": {
            "generationConfig": {
              "thinkingConfig": {
                "thinkingLevel": "MEDIUM"
              }
            }
          }
        },
        "gemini-2.5-flash-lite": {
          "limit": {
            "context": 1048576,
            "output": 8192
          }
        },
        "gemma-4-31b-it": {
          "limit": {
            "context": 262144,
            "output": 8192
          }
        },
        "gemma-4-26b-a4b-it": {
          "limit": {
            "context": 262144,
            "output": 8192
          }
        },
        "gemini-3.8-flash": {
          "limit": {
            "context": 1048576,
            "output": 8192
          },
          "body": {
            "generationConfig": {
              "thinkingConfig": {
                "thinkingLevel": "MEDIUM"
              }
            }
          }
        }
      },
      "env": [
        "GOOGLE_GENERATIVE_AI_API_KEY"
      ]
    },
    "openrouter": {
      "env": [
        "OPENROUTER_API_KEY"
      ],
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b:free": {
          "name": "NVIDIA Nemotron 3 Ultra (Free Fallback)",
          "limit": {
            "context": 1048576,
            "output": 8192
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "tools": {
        "bash": true,
        "read": true,
        "edit": true,
        "write": true,
        "glob": true,
        "grep": true,
        "list": true,
        "patch": false,
        "task": false,
        "todowrite": false,
        "webfetch": false,
        "websearch": false,
        "question": false,
        "lsp": false,
        "skill": false
      }
    }
  }
}
