{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "groq": {
      "models": {
        "openai/gpt-oss-120b": {
          "body": {
            "max_completion_tokens": 1024,
            "reasoning_effort": "low",
            "reasoning_format": "hidden"
          },
          "limit": {
            "output": 1024
          }
        },
        "qwen/qwen3.8-27b": {
          "body": {
            "max_completion_tokens": 1024,
            "reasoning_effort": "low",
            "reasoning_format": "hidden"
          },
          "limit": {
            "output": 1024
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "tools": {
        "bash": true,
        "read": true,
        "edit": true,
        "write": true,
        "glob": true,
        "grep": true,
        "list": true,
        "patch": false,
        "task": false,
        "todowrite": false,
        "webfetch": false,
        "websearch": false,
        "question": false,
        "lsp": false,
        "skill": false
      }
    }
  }
}
